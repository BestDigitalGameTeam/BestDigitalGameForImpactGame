  m_Name: 
  m_EditorClassIdentifier: 
  AnnouncerDialogueSubtitles:
    _serializedList:
    - Key: 0
      Value: Welcome, participant. Thank you for agreeing to take part in our new
        algorithm training program. Your participation is greatly appreciated.
    - Key: 1
      Value: Beginning evaluation...
    - Key: 11
      Value: Based on your evaluation, I think you'd like a puzzle game.
    - Key: 12
      Value: Based on your evaluation, I think you'd like a platformer game.
    - Key: 13
      Value: Based on your evaluation, I think you'd like a shooter game.
    - Key: 20
      Value: I'm glad you enjoyed your first level.
    - Key: 21
      Value: Please choose a door.
    - Key: 30
      Value: Would you like to see more of this content?
    - Key: 40
      Value: I'm glad you liked it so much. Now you can do it again!
    - Key: 41
      Value: I knew I was right!
    - Key: 42
      Value: You can have two options.
    - Key: 43
      Value: These two are the ones you want.
    - Key: 50
      Value: You don't want to show more of this content?
    - Key: 61
      Value: But you liked this one first!
    - Key: 62
      Value: Let's try that again.
    - Key: 65
      Value: I was probably right the first time.
    - Key: 66
      Value: How about I give you more of what I first gave you?
    - Key: 70
      Value: Still no?!
